# ================================
# PAIOL — Variables de Entorno
# ================================
# Copiá este archivo como .env y completá tus credenciales
# NUNCA subas .env a git

# --- IOL (InvertirOnline) ---
IOL_USERNAME=tu_usuario_iol
IOL_PASSWORD=tu_password_iol
IOL_SANDBOX=true

# --- Gemini (Google AI) ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# --- Email para reportes (opcional, Gmail) ---
PAIOL_EMAIL_FROM=tu_email@gmail.com
PAIOL_EMAIL_TO=tu_email@gmail.com
PAIOL_EMAIL_PASSWORD=tu_app_password_de_gmail

# --- Trading ---
PAIOL_CANTIDAD_DEFAULT=10
PAIOL_CONFIANZA_MINIMA=0.5

# --- Modelo ---
PAIOL_MODEL_PATH=model/xgboost_model.json
